FROM registry.hackeneering.com/hackeneering/rpi-firmware-base:bookworm-arm64-latest

ARG COMMIT_HASH=unknown
LABEL org.opencontainers.image.revision="${COMMIT_HASH}"
LABEL org.opencontainers.image.description="Raspberry Pi streaming sensor base image"

# All apt-installed runtime dependencies in one pass.
#
# IMPORTANT: this is the *only* apt-get install in the file. Anything new
# that needs apt must be added here, BEFORE the libcamera downgrade step
# below — which leaves the system in a state apt considers "broken" (the
# downgraded libcamera0.5 0.5.0 fails to satisfy gstreamer1.0-libcamera's
# and libcamera-v4l2's `Depends: libcamera0.5 (>= 0.5.2+rpt...)`). Runtime
# ABI compatibility holds, but `apt-get install` refuses to proceed once
# the system is in that state.
RUN apt-get update && apt-get install -y --no-install-recommends \
        gstreamer1.0-tools \
        gstreamer1.0-plugins-base \
        gstreamer1.0-plugins-good \
        gstreamer1.0-plugins-bad \
        gstreamer1.0-plugins-ugly \
        gstreamer1.0-libav \
        gstreamer1.0-rtsp \
        gstreamer1.0-libcamera \
        libgstreamer1.0-0 \
        libgstreamer-plugins-base1.0-0 \
        libgstreamer-plugins-bad1.0-0 \
        libcamera0.5 \
        libcamera-ipa \
        libcamera-tools \
        libcamera-v4l2 \
        v4l-utils \
        python3 \
        python3-numpy \
        python3-opencv \
        picocom \
        setserial \
    && rm -rf /var/lib/apt/lists/*

# libcamera pinning — 0.5.0+rpt20250707-5 for arducam-pivariety driver compat (#2).
#
# Upstream archive.raspberrypi.com only ships the latest 0.5.2+rpt2025...,
# which added mandatory V4L2 controls the (also pinned) arducam-pivariety
# kernel module on Arducam ToF kits doesn't expose — breaking libcamerasrc
# on the kits even though native rpicam-hello works on the host. We
# downgrade the three libcamera packages to the version known to work,
# then mark them held + add an apt preferences pin so any downstream
# `apt-get install` in sensor images can't accidentally upgrade them back.
#
# This must be the LAST apt/dpkg operation in the file — see comment
# above the apt block.
COPY debs/libcamera0.5_0.5.0+rpt20250707-5_arm64.deb     /tmp/libcamera-debs/
COPY debs/libcamera-ipa_0.5.0+rpt20250707-5_arm64.deb    /tmp/libcamera-debs/
COPY debs/libcamera-tools_0.5.0+rpt20250429-1_arm64.deb  /tmp/libcamera-debs/
RUN dpkg -i --force-downgrade --force-depends \
        /tmp/libcamera-debs/libcamera0.5_0.5.0+rpt20250707-5_arm64.deb \
        /tmp/libcamera-debs/libcamera-ipa_0.5.0+rpt20250707-5_arm64.deb \
        /tmp/libcamera-debs/libcamera-tools_0.5.0+rpt20250429-1_arm64.deb \
    && rm -rf /tmp/libcamera-debs \
    && ldconfig \
    && printf 'Package: libcamera0.5 libcamera-ipa libcamera-tools libcamera-v4l2\nPin: version *\nPin-Priority: 1001\n' \
        > /etc/apt/preferences.d/libcamera-hold \
    && apt-mark hold libcamera0.5 libcamera-ipa libcamera-tools libcamera-v4l2

# MediaMTX RTSP server (statically-linked Go binary, checksum verified)
ARG MEDIAMTX_VERSION=v1.16.3
ARG MEDIAMTX_SHA256=e584c298af70f72753ebfbde20fb3565948724ce0a9817045096ba828e7f6a56
RUN curl -fsSL "https://github.com/bluenviron/mediamtx/releases/download/${MEDIAMTX_VERSION}/mediamtx_${MEDIAMTX_VERSION}_linux_arm64.tar.gz" \
        -o /tmp/mediamtx.tar.gz \
    && echo "${MEDIAMTX_SHA256}  /tmp/mediamtx.tar.gz" | sha256sum -c - \
    && tar xz -C /usr/local/bin mediamtx < /tmp/mediamtx.tar.gz \
    && rm /tmp/mediamtx.tar.gz \
    && chmod +x /usr/local/bin/mediamtx

# Preserve firmware-base self-test, then install ours
RUN mv /usr/local/bin/self-test /usr/local/bin/self-test-firmware 2>/dev/null || true
COPY self-test.sh /usr/local/bin/self-test
RUN chmod +x /usr/local/bin/self-test
